# Backend API base URL. Leave empty while using the local mock data.
VITE_API_URL=
VITE_USE_MOCK_DATA=true
# Demo-only credentials. Do not use these for production authentication.
VITE_DEMO_EMAIL=admin@example.com
VITE_DEMO_PASSWORD=change-me

# Google sign-in
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Add your dev URL (e.g. http://localhost:5173) and production URL as authorized JS origins.
VITE_GOOGLE_CLIENT_ID=

# Apple sign-in
# Apple Developer > Certificates, IDs & Profiles > Identifiers > Services ID
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
