PORT=3000
FRONTEND_URL=https://your-frontend.vercel.app
# Use "lax" for local HTTP development; "none" is for cross-site HTTPS deployments.
AUTH_COOKIE_SAME_SITE=none
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-scrypt-salt-and-hash
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-web-client-id

# Firebase Admin service-account JSON; keep this server-side and out of source control.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional overrides; project_id is read from the service account when omitted.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
INTERNAL_API_SECRET=replace-with-a-long-random-secret
