# Google sign-in
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Add your dev URL (e.g. http://localhost:5173) and production URL as authorized JS origins.
VITE_GOOGLE_CLIENT_ID=

# Apple sign-in
# Apple Developer > Certificates, IDs & Profiles > Identifiers > Services ID
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
